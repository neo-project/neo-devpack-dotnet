<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup>
    <Copyright>2015-2026 The Neo Project</Copyright>
    <Company>The Neo Project</Company>
    <VersionPrefix>3.10.1</VersionPrefix>
    <NeoCorePackageVersion>3.10.1</NeoCorePackageVersion>
    <Authors>The Neo Project</Authors>
    <PackageProjectUrl>https://github.com/neo-project/neo-devpack-dotnet</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/neo-project/neo-devpack-dotnet.git</RepositoryUrl>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- XML files are generated for API consumers; documentation coverage is tracked separately. -->
    <NoWarn>$(NoWarn);CS1570;CS1571;CS1572;CS1573;CS1574;CS1584;CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../neo.png" Pack="true" Visible="false" PackagePath=""/>
  </ItemGroup>
</Project>
