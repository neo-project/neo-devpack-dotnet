          "System.Single"
        ]
      },
      "diagnostic": {
        "id": "NC4002",
        "severity": "Error",
        "guidance": "Use integer or BigInteger fixed-point arithmetic with an explicit scale.",
        "helpLink": "docs/diagnostics/NC4002.md"
