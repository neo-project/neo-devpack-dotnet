      "since": "3.9.1",
      "evidence": [
        {
          "kind": "analyzer-negative",
          "reference": "FloatUsageAnalyzerUnitTest"
        },
        {
          "kind": "compiler",
          "reference": "DiagnosticId.FloatingPointNumber"
        }
      ]
