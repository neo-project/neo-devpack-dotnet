        {
          "kind": "compiler",
          "reference": "SystemCall.Boolean"
        },
        {
          "kind": "runtime",
          "reference": "UnitTest_Boolean.TryParse"
        },
        {
          "kind": "differential",
          "reference": "UnitTest_Boolean.TryParseSemanticDifference"
